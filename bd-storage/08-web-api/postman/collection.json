{
  "info": {
    "name": "Seattle Library API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET top 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/titles/top?year=2021&limit=5",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "titles",
            "top"
          ],
          "query": [
            {
              "key": "year",
              "value": "2021"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"5 rows\", () => pm.expect(j.length).to.eql(5));",
              "pm.collectionVariables.set(\"title\", j[0].title);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET top без year 422",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/titles/top?limit=5",
          "host": [
            "{{base_url}}"
          ],
