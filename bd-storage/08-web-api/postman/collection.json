          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"non-empty\", () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    },
