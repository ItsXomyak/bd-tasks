          }
        }
      ]
    },
    {
      "name": "3. GET по названию 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/titles/{{title}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
