{
  "info": {
    "name": "Seattle Library API (занятие 14)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Без ключа 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/titles/top?year=2021",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "titles",
            "top"
          ],
          "query": [
            {
              "key": "year",
              "value": "2021"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Неверный ключ 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "wrong-key"
          }
        ],
        "url": {
          "raw": "{{base_url}}/titles/top?year=2021",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "titles",
            "top"
          ],
          "query": [
            {
              "key": "year",
              "value": "2021"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Верный ключ 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/titles/top?year=2021&limit=3",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "titles",
            "top"
          ],
          "query": [
            {
              "key": "year",
              "value": "2021"
            },
            {
              "key": "limit",
              "value": "3"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"3 rows\", () => pm.expect(pm.response.json().length).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. format=json 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/titles/top?year=2021&limit=3&format=json",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "titles",
            "top"
          ],
          "query": [
            {
              "key": "year",
              "value": "2021"
            },
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "format",
              "value": "json"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"json content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. format=xml 200",
      "request": {
