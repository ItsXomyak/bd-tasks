    {
      "name": "6. POST без ключа 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/checkouts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "checkouts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title_id\": 1,\n  \"year\": 2021,\n  \"month\": 7,\n  \"material_type\": \"SOUNDDISC\",\n  \"checkouts\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
